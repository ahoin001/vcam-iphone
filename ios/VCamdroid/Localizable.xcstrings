    "howToConnectWiFi" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the phone and the PC on the same Wi-Fi network. In VCamPanel, select the phone or type the address shown here, then click Connect. Turn off VPN and router client isolation if the PC cannot see the phone."
          }
        }
      }
    },
