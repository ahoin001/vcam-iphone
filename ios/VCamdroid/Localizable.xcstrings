      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portrait is on this iPhone. NVIDIA Broadcast or OBS Background Removal on the PC is cleaner. 1080p30 and plugged in keeps the phone cooler."
          }
        }
      }
    },
    "portraitControlHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave Portrait off for a cleaner cut. On the PC, choose VCamdroid in NVIDIA Broadcast, or add Background Removal in OBS. This iPhone blur is a light backup and warms the phone."
          }
        }
      }
    },
    "portraitSmoothnessHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portrait can drop frames on the phone. For the smoothest feed, leave it off and watch OBS."
          }
        }
      }
