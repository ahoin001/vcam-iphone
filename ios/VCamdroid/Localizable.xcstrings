    "howToConnectUSB" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Apple Devices from the Microsoft Store and open it once. Plug in the phone, unlock it, and tap Trust This Computer. In VCamPanel, select the USB phone and click Connect."
          }
        }
      }
    },
