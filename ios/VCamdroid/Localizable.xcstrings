    "howToConnect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to connect"
          }
        }
      }
    },
    "howToConnectCurtain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use 1080p at 30 fps. For recording, set bitrate to 6000–8000 kbps. Keep the phone plugged in, leave Low Power Mode off, and use Automatic curtain so the screen goes black while you shoot. USB stays cooler than Wi-Fi. If the phone warns that it is hot, drop bitrate toward 4000, keep the curtain on, and take the case off. The side button ends the broadcast."
          }
        }
      }
    },
    "howToConnectDesk" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the Controls link from the studio screen. In OBS, open Docks → Custom Browser Docks and paste it. On Windows you can also open VCamPanel and paste the same link. Zoom, exposure, white balance, focus, torch, and flip change without reconnecting OBS."
          }
        }
      }
    },
    "howToConnectDeskTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desk controls"
          }
        }
      }
    },
    "howToConnectLongTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long sessions"
          }
        }
      }
    },
    "howToConnectTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to connect"
          }
        }
      }
    },
    "howToConnectUSB" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Apple Devices or iTunes, tap Trust This Computer, then run usbmux_forward or open VCamPanel for port 4747. In OBS, connect to 127.0.0.1 on that port. Prefer USB for long recordings; it is steadier and cooler than Wi-Fi."
          }
        }
      }
    },
    "howToConnectUSBTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB"
          }
        }
      }
    },
    "howToConnectWiFi" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the phone and the PC on the same network, preferably 5 GHz. In OBS, add a VCamdroid or DroidCam OBS source using the IP and port shown on the phone. Turn off VPN and router client isolation if the PC cannot reach the phone."
          }
        }
      }
    },
    "howToConnectWiFiTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi"
          }
        }
      }
    },
