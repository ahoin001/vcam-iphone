    "howToConnectCurtain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If VCamPanel says it is receiving the picture but cannot decode it, leave this screen open and click Connect again. If it says USB is connected but VCamdroid is not on the camera screen, open this screen and leave it in front. Waiting for the computer means the phone is ready and the PC has not connected yet."
          }
        }
      }
    },
    "howToConnectDesk" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In NVIDIA Broadcast, OBS, Zoom, Teams, Meet, or Discord, choose the camera named VCamdroid. VCamPanel has to stay open."
          }
        }
      }
    },
