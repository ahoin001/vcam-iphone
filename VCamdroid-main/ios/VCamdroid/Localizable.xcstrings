    "portraitCareBattery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait uses extra battery. Plug in when you can."
          }
        }
      }
    },
    "portraitCareEased": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait is using a lighter blur so the phone can cool down."
          }
        }
      }
    },
    "portraitCareHeavier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resolution works harder. 1080p30 is easier on the phone."
          }
        }
      }
    },
    "portraitCareHeavierBattery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resolution uses extra power. 1080p30 and a charger are easier on the phone."
          }
        }
      }
    },
    "portraitCarePaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait is paused until the phone cools down."
          }
        }
      }
    },
    "portraitCareSteady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait is on this iPhone. NVIDIA Broadcast or OBS Background Removal on the PC is cleaner. 1080p30 and plugged in keeps the phone cooler."
          }
        }
      }
    },
    "portraitControlHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave Portrait off for a cleaner cut. On the PC, choose VCamdroid in NVIDIA Broadcast, or add Background Removal in OBS. This iPhone blur is a light backup and warms the phone."
          }
        }
      }
    },
    "portraitSmoothnessHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait can drop frames on the phone. For the smoothest feed, leave it off and watch OBS."
          }
        }
      }
    },
    "portraitOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "portraitPhonePreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone preview"
          }
        }
      }
    },
    "portraitPhonePreviewHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this off. Watch the picture on the computer. Showing the blur here uses more of the phone."
          }
        }
      }
    },
    "portraitPreviewBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone preview is off so the phone stays cooler. Watch the picture on the computer. For a cleaner background, leave Portrait off and use NVIDIA Broadcast or OBS Background Removal on the PC."
          }
        }
      }
    },
    "portraitPreviewShow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show on iPhone"
          }
        }
      }
    },
    "portraitPreviewTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch portrait on the PC"
          }
        }
      }
    },
    "portraitSettingsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait is a light blur on this iPhone. For a cleaner background, leave it off and do the cut on the PC: NVIDIA Broadcast with camera VCamdroid, or Background Removal on a VCamdroid source in OBS. Do not run both, or the edges stack and the phone runs hotter. If you use this iPhone blur, leave iPhone preview off, stay at 1080p30, and keep the phone plugged in. Portrait switches to a lighter blur when the phone gets hot, and it pauses if the phone needs to cool down. The picture keeps streaming."
          }
        }
      }
    },
    "portraitStrength": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength"
          }
        }
      }
    },
    "previewMatches": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview matches the broadcast."
          }
        }
      }
    },
    "resolution": {
