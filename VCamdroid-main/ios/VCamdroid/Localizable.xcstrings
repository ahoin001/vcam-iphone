    "portraitSettingsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portrait blurs the background on this iPhone, so the computer does not have to. Leave iPhone preview off and watch the picture in OBS. 1080p30 is the easiest mode. Keep the phone plugged in, and take the case off if it warms up. Portrait switches to a lighter blur when the phone gets hot, and it pauses if the phone needs to cool down. The picture keeps streaming."
          }
        }
      }
