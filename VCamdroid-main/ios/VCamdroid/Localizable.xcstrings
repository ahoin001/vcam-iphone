          }
        }
      }
    },
    "sessionSettingsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic dims after 8 seconds of no touch. Always dim stays dark until you tap. Off never auto-dims; the moon still works. Tap the moon to dim now. Long-press it to change the mode."
          }
        }
      }
    },
