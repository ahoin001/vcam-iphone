    },
    "portraitCareHeavierBattery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resolution uses extra power. 1080p30 and a charger are easier on the phone."
          }
        }
      }
    },
    "portraitCareEased": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait is using a lighter blur so the phone can cool down."
