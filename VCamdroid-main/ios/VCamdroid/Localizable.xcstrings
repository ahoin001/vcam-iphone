    "homeSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this iPhone as a Windows camera named VCamdroid. Open the studio, then Connect in VCamPanel."
          }
        }
      }
    },
    "homeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VCamdroid"
          }
        }
      }
    },
    "howToConnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to connect"
          }
        }
      }
    },
    "howToConnectCurtain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1080p at 30 fps. Keep the phone plugged in, leave Low Power Mode off, and use Automatic curtain so the screen goes black while you shoot. USB stays cooler than Wi-Fi. If the phone warns that it is hot, keep the curtain on and take the case off. The side button pauses the stream."
          }
        }
      }
    },
    "howToConnectDesk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shot controls live in VCamPanel after Connect: zoom, exposure, white balance, focus, torch, flip, and portrait. You do not need to paste a link."
          }
        }
      }
    },
    "howToConnectDeskTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desk controls"
          }
        }
      }
    },
    "howToConnectLongTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long sessions"
          }
        }
      }
    },
    "howToConnectTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to connect"
          }
        }
      }
    },
    "howToConnectUSB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Apple Devices or iTunes, tap Trust This Computer, open the studio, then Connect the USB phone in VCamPanel. Prefer USB for long recordings; it is steadier and cooler than Wi-Fi."
          }
        }
      }
    },
    "howToConnectUSBTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB"
          }
        }
      }
    },
    "howToConnectWiFi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the phone and the PC on the same network, preferably 5 GHz. Open the studio, then in VCamPanel click Refresh and Connect. Turn off VPN and router client isolation if the PC cannot reach the phone."
          }
        }
      }
    },
    "howToConnectWiFiTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
