      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto is smoothest for most rooms. Use EV to brighten or darken without touching shutter."
          }
        }
      }
    },
    "exposureManualHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 30 fps keep shutter at 1/60 or faster. Slower shutter looks smear and choppy. Raise ISO to brighten instead."
          }
        }
      }
    },
