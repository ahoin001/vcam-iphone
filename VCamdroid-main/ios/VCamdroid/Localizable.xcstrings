    "howToConnectWiFi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: put the phone and the PC on the same network. In OBS, add a VCamdroid or DroidCam OBS source using the IP and port shown on the phone."
          }
        }
      }
    },
    "howToConnectUSB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB: install Apple Devices or iTunes, tap Trust This Computer, then run usbmux_forward for port 4747. In OBS, connect to 127.0.0.1 on that port."
          }
        }
      }
    },
    "howToConnectCurtain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The curtain turns the screen black while the app stays open. The side button ends the broadcast."
          }
        }
      }
    },
