    "portSettingsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VCamPanel uses this port. Change it only if 4747 is already in use. Wi-Fi discovery takes effect the next time you open the studio."
          }
        }
      }
    },
    "outputSettingsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rates are for a DroidCam OBS source. VCamPanel publishes 1080p30 at its own Wi-Fi or USB rate. 4000 kbps suits live calls; 6000–8000 kbps suits recording. Higher bitrate and 60 fps make the phone warmer."
          }
        }
      }
    },
    "panelControls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
